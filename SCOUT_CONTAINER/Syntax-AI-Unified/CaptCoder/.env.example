# Syntax AI CaptCoder - Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================================================
# NEXUS API CONFIGURATION
# ============================================================================
# The Multimodal Command Nexus is the central communication hub
NEXUS_API_HOST=127.0.0.1
NEXUS_API_PORT=8000
NEXUS_COMMAND_URL=http://${NEXUS_API_HOST}:${NEXUS_API_PORT}/command
NEXUS_API_KEY=
NEXUS_HTTPS=False
NEXUS_AUTH_ENABLED=False
NEXUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173

# ============================================================================
# BSM (BLUE SKY MEETING) CONFIGURATION
# ============================================================================
# Tag used to trigger Blue Sky Meeting mode
BSM_TRIGGER_TAG=#bsm

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================
# Directories to monitor for code files (comma-separated)
MONITOR_DIRECTORIES=/storage/emulated/0/Download,/storage/emulated/0/Documents,/storage/emulated/0/scripts

# Check interval for file monitoring (seconds)
WATCH_INTERVAL_SECONDS=30

# File extensions to monitor
MONITOR_EXTENSIONS=.py,.js,.ts,.txt,.html,.css,.md

# ============================================================================
# CODE OPTIMIZATION (BITCH WORK PROTOCOL)
# ============================================================================
# Enable auto-fix (creates backups)
OPTIMIZATION_AUTO_FIX=False

# Directories to exclude from optimization scan
OPTIMIZATION_SCAN_EXCLUDE=.git,venv,node_modules,dist,__pycache__,.vscode

# Optimization rules
OPTIMIZATION_RULES={"long_functions": 50, "missing_docstrings": true, "print_statements": true, "magic_numbers": true}

# ============================================================================
# TTS (TEXT-TO-SPEECH) CONFIGURATION
# ============================================================================
# Enable TTS feedback
TTS_ENABLED=True

# TTS engine (espeak, festival, etc.)
TTS_ENGINE=espeak

# TTS voice parameters
TTS_SPEED=150
TTS_PITCH=50
TTS_VOICE=default

# ============================================================================
# LIVESTREAM CONFIGURATION
# ============================================================================
# Streaming provider (restream.io, streamyard, custom)
LIVESTREAM_PROVIDER=restream.io

# Streaming endpoints (comma-separated)
LIVESTREAM_ENDPOINTS=youtube,tiktok,instagram

# API keys for streaming services
LIVESTREAM_API_KEY=
RESTREAM_API_KEY=
STREAMYARD_API_KEY=
YOUTUBE_API_KEY=

# Stream quality settings
LIVESTREAM_QUALITY=1080p
LIVESTREAM_FPS=30
LIVESTREAM_BITRATE=6000

# ============================================================================
# DREAMTABLE SANDBOX & LOOKING GLASS
# ============================================================================
# Sandbox API endpoint
SANDBOX_API_URL=http://localhost:8001

# Looking Glass endpoint
LOOKING_GLASS_URL=http://localhost:3000/looking-glass

# ============================================================================
# FILE OUTPUT CONFIGURATION
# ============================================================================
# Output directory for extracted code
OUTPUT_DIR=/storage/emulated/0/auto_extracted_code

# Output directory for generated code
GENERATED_CODE_DIR=generated_code

# Output directory for logs
LOGS_DIR=logs

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable file logging
LOG_TO_FILE=True

# Log file rotation
LOG_MAX_SIZE=10485760  # 10MB
LOG_MAX_FILES=5

# ============================================================================
# PERFORMANCE CONFIGURATION
# ============================================================================
# Maximum memory usage (MB)
MAX_MEMORY_MB=512

# Maximum CPU usage (%)
MAX_CPU_PERCENT=80

# Worker threads
WORKER_THREADS=4

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Enable input validation
ENABLE_VALIDATION=True

# Enable dangerous pattern detection
ENABLE_DANGEROUS_PATTERN_CHECK=True

# Maximum input length
MAX_INPUT_LENGTH=10000

# ============================================================================
# IDEAL INTEGRATION
# ============================================================================
# IDEal IDE endpoint
IDEAL_API_URL=http://localhost:8080

# IDEal plugin settings
IDEAL_PLUGIN_ENABLED=True
IDEAL_AUTO_SAVE=True

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================
# Development mode (more verbose, less strict)
DEV_MODE=False

# Enable debug logging
DEBUG=True

# Test mode
TEST_MODE=False
