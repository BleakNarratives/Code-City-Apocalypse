{
  "name": "syntax-ai-captcoder",
  "version": "1.0.0",
  "description": "Syntax AI CaptCoder - Unified code intelligence and extraction system",
  "main": "src/typescript/main.tsx",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/typescript/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vitest": "^0.30.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "prettier": "^3.0.0"
  },
  "keywords": [
    "syntax-ai",
    "captcoder",
    "code-extraction",
    "code-optimization",
    "blue-sky-meeting",
    "live-coding",
    "ai-assisted-development"
  ],
  "author": "Syntax AI Team",
  "license": "MIT",
  "homepage": "https://github.com/Syntax-AI/CaptCoder",
  "repository": {
    "type": "git",
    "url": "https://github.com/Syntax-AI/CaptCoder.git"
  },
  "bugs": {
    "url": "https://github.com/Syntax-AI/CaptCoder/issues"
  }
}
